issues:
  fix: false
  exclude-rules:
    - path: internal/config/config.go
      linters:
        - forcetypeassert
    - path: _test\.go
      linters:
        - lll
        - funlen
        - paralleltest
        - tparallel
linters:
  enable:
    # Enabled by default
    - errcheck
    - gosimple
    - govet
    - ineffassign
    - staticcheck
    - typecheck
    - unused
    # Enabled specifically
    - wsl
    - lll
    - cyclop
    - bodyclose
    - asciicheck
    - dupl
    - errorlint
    - dogsled
    - durationcheck
    - gocritic
    - gocyclo
    - gci
    - gocognit
    - goconst
    - godot
    - godox
    - gosec
    - exhaustive
    - forbidigo
    - forcetypeassert
    - funlen
    - gofmt
    - gofumpt
    - goheader
    - gomoddirectives
    - gomodguard
    - goprintffuncname
    - importas
    - makezero
    - misspell
    - nakedret
    - nestif
    - nilerr
    - nlreturn
    - noctx
    - nolintlint
    - paralleltest
    - predeclared
    - promlinter
    - revive
    - rowserrcheck
    - sqlclosecheck
    - stylecheck
    - tagliatelle
    - testpackage
    - thelper
    - tparallel
    - unconvert
    - unparam
    - wastedassign
    - whitespace
    - goimports
  disable:
    - wrapcheck # Too restrictive as it forces wrapping of errors in a valid no-wrap scenarios.
    - gochecknoglobals # Too restrictive and controversial.
    - gochecknoinits # Too restrictive and controversial.
    - gomnd # Too restrictive and generating configuration-related false positives.
    - prealloc # Too restrictive and generating a lot of false positives.
  fast: false
linters-settings:
  lll:
    line-length: 160
  gci:
    sections:
      - standard
      - default
      - prefix(github.com/futurehomeno/{{.RepositoryName}})
      - alias
  goimports:
    local-prefixes: github.com/futurehomeno/{{.RepositoryName}}
